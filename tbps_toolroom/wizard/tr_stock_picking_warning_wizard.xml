<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <record id="tr_stock_picking_warning_wizard" model="ir.ui.view">
    <field name="name">tr.stock.picking.warning.wizard</field>
    <field name="model">tr.stock.picking.warning.wizard</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group col="4">
            <field name="message" />
          </group>
          <footer>
            <button name="action_confirm" string="Guardar y continuar" type="object" class="oe_highlight"/>
            <button string="Descartar" special="cancel"/>
          </footer>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_stock_picking_warning_wizard" model="ir.actions.act_window">
    <field name="name">Herramienta Asignada</field>
    <field name="res_model">tr.stock.picking.warning.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>


</odoo>


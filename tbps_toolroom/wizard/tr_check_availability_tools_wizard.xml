<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <record id="wizard_check_availability_tools" model="ir.ui.view">
    <field name="name">wizard.check.availability.tool</field>
    <field name="model">check.availability.tool.wizard</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group col="4">
            <field name="product_id" placeholder="Seleccione" />
            <field name="product_availability" />
          </group>
          <footer>
            <!--<button name="action_reserve" string="Guardar y cerrar" type="object" class="oe_highlight"/>-->
            <!--<button name="action_continue" string="Guardar y continuar" type="object" class="oe_highlight"/>-->
            <button string="Descartar" special="cancel"/>
          </footer>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_check_availability_tool_wizard" model="ir.actions.act_window">
    <field name="name">Comprobar disponibilidad de herramientas</field>
    <field name="res_model">check.availability.tool.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <menuitem name="Consultar Disponibilidad"
    action="action_check_availability_tool_wizard"
    id="menu_check_availability_tool_wizard"
    parent="tbps_toolroom.menu_operations"
    sequence="2"
    groups="base.group_user,base.group_system"
  />

</odoo>

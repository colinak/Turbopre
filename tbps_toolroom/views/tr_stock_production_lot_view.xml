<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <!--view search stock produccion lot-->
    <record id="view_tr_stock_production_lot_search" model="ir.ui.view">
      <field name="name">tr.stock.production.lot.search</field>
      <field name="model">tr.stock.production.lot</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search string="Toolroom N° de Serie">
          <field string="N° Serial TPS" name="name" filter_domain="['|', ('name', 'ilike', self),('ref', 'ilike', self)]"/>
          <field name="product_id" string="Herramienta"/>
          <field name="ref"/>
          <field name="employee_id"/>
          <field name="location_id"/>
          <field name="assigned_date"/>
          <separator/>
          <filter string="Inventario" name="stock" domain="[('stage', '!=', 'discarded')]"/>
          <filter string="Disponible" name="available" domain="[('stage', '=', 'available')]"/>
          <filter string="Asignado" name="assigned" domain="[('stage', '=', 'assigned')]"/>
          <filter string="Prestado" name="loan" domain="[('stage', '=', 'loan')]"/>
          <filter string="Reservado" name="reserved" domain="[('stage', '=', 'reserved')]"/>
          <filter string="En Custodia" name="in_custody" domain="[('stage', '=', 'in_custody')]"/>
          <filter string="Perdida" name="loss" domain="[('stage', '=', 'loss')]"/>
          <filter string="Averiado" name="fault" domain="[('stage', '=', 'fault')]"/>
          <filter string="Desechado" name="discarded" domain="[('stage', '=', 'discarded')]"/>
          <group expand="0" string="Group By">
            <filter name="group_by_product" string="Producto" domain="[('stage', '!=', 'discarded')]" context="{'group_by': 'product_id'}"/>
            <filter name="group_by_employee" string="Empleado" domain="[]" context="{'group_by': 'employee_id'}"/>
            <filter name="group_by_location" string="Ubicación" domain="[]" context="{'group_by': 'location_id'}"/>
            <filter name="group_by_stage" string="Disponibilidad" domain="[]" context="{'group_by': 'stage'}"/>
            <filter name="group_by_state" string="Estatus" domain="[]" context="{'group_by': 'state'}"/>
          </group>
        </search>
      </field>
    </record>

    <!--View form Lot-->
    <record id="view_tr_stock_production_lot_form" model="ir.ui.view">
      <field name="name">tr.stock.production.lot.form</field>
      <field name="model">tr.stock.production.lot</field>
      <field name="type">form</field>
      <field name="arch" type="xml">
        <form string="Toolroom N° Serie">
          <header>
            <field name="active" invisible="1" />
            <field name="assigned_date" invisible="1" />
            <field name="company_id" invisible="1" />
            <field name="stage" invisible="1" />
            <field name="state" widget="statusbar" statusbar_visible="draft,done,cancel"/>
          </header>
          <sheet>
            <widget name="web_ribbon" title="DISPONIBLE" bg_color="bg-success" attrs="{'invisible': [('stage', '!=', 'available')]}"/>
            <widget name="web_ribbon" title="ASIGNADA" bg_color="bg-info" attrs="{'invisible': [('stage', '!=', 'assigned')]}"/>
            <widget name="web_ribbon" title="PRESTADA" bg_color="bg-info" attrs="{'invisible': [('stage', '!=', 'loan')]}"/>
            <widget name="web_ribbon" title="RESERVADA" bg_color="bg-warning" attrs="{'invisible': [('stage', '!=', 'reserved')]}"/>
            <widget name="web_ribbon" title="CUSTODIADA" bg_color="bg-warning" attrs="{'invisible': [('stage', '!=', 'in_custody')]}"/>
            <!--<widget name="web_ribbon" title="PERDIDA" bg_color="bg-muted" attrs="{'invisible': [('stage', '!=', 'loss')]}"/>-->
            <widget name="web_ribbon" title="PERDIDA" bg_color="bg-warning" attrs="{'invisible': [('stage', '!=', 'loss')]}"/>
            <widget name="web_ribbon" title="AVERIADA" bg_color="bg-info" attrs="{'invisible': [('stage', '!=', 'fault')]}"/>
            <widget name="web_ribbon" title="DESECHADA" bg_color="bg-danger" attrs="{'invisible': [('stage', '!=', 'discarded')]}"/>
            <div class="oe_title">
              <label for="name" string="N° Serial TPS" class="oe_edit_only"/>
              <h1>
                <field name="name" placeholder="Ej. LOT/0001/20121" style="width: 80%;" />
              </h1>
            </div>
            <group name="main_group">
              <group>
                <field name="product_id" string="Herramienta" placeholder="Seleccione" context="{'default_type': 'product'}" help="Producto que contiene este número de serie. Ya no puedes cambiarlo si ya se ha movido."/>
                <label for="product_qty" />
                <div class="o_row" >
                  <field name="product_qty" readonly="1"/>
                  <field name="product_uom_id" readonly="1" groups="uom.group_uom"/>
                </div>
                <field name="required_certification" />
                <label for="certification_frequency" class="oe_edit_only" attrs="{'invisible': [('required_certification', '=', False)]}" />
                <div class="o_row" attrs="{'invisible': [('required_certification', '=', False)]}">
                  <field name="certification_frequency" attrs="{'invisible': [('required_certification', '=', False)], 'required': [('required_certification', '=', True)]}" />
                  <span>Meses</span>
                </div>
                <field name="execute_date" placeholder="Seleccione" attrs="{'invisible': [('required_certification', '=', False)], 'required': [('required_certification', '=', True)]}"/>
                <field name="expiration_date" placeholder="Seleccione" attrs="{'invisible': [('required_certification', '=', False)], 'required': [('required_certification', '=', True)]}"/>
                <field name="final_condition" string="Estado" placeholder="Seleccione" attrs="{'invisible': [('required_certification', '=', False)], 'required': [('required_certification', '=', True)]}"/>
                <field name="ref"/>
                <field name="company_id" invisible="True"/>
              </group>
            </group>
            <group string="Notas Externas">
              <field name="note" string="Información adicional" placeholder="Nota Externa..." />
            </group>
            <div class="oe_chatter">
              <field name="message_follower_ids" string="Enviar mensaje" widget="mail_followers"/>
              <field name="activity_ids" string="Registrar un nota" />
              <field name="message_ids" string="Planificar una actividad" widget="mail_thread"/>
            </div>
          </sheet>
        </form>
      </field>
    </record>

    <!--view tree stock produccion lot-->
    <record id="view_tr_stock_production_lot_tree" model="ir.ui.view">
      <field name="name">tr.stock.production.lot.tree</field>
      <field name="model">tr.stock.production.lot</field>
      <field name="type">tree</field>
      <field name="arch" type="xml">
        <tree string="Lots/Serial Numbers" multi_edit="1">
          <field name="name" string="N° Serial TPS" decoration-bf="1"/>
          <field name="product_id" string="Herramienta" readonly="1" />
          <field name="employee_id" string="Empleado Asignado" optional="hide"/>
          <field name="location_id" string="Ubicación" optional="hide"/>
          <field name="ref" optional="hide" />
          <field name="create_date" optional="show" string="Creado en"/>
          <field name="company_id" invisible="1"/>
          <field name="stage" string="Disponibilidad" widget="badge" decoration-success="stage == 'available'" decoration-info="stage in ('assigned', 'loan', 'in_custody', 'fault')" decoration-warning="stage == 'loss'" decoration-danger="stage == 'discarded'"/>
          <field name="state" string="Estatus" widget="badge" decoration-success="state == 'done'" decoration-info="state in ('draft', 'confirm')" />
          <field name="certification_frequency" optional="hide" />
          <field name="execute_date" optional="hide" />
          <field name="expiration_date" optional="hide" />
          <field name="final_condition" string="Estado" optional="hide" widget="badge" decoration-success="final_condition == 'current'" decoration-danger="final_condition == 'expired'"/>
        </tree>
      </field>
    </record>

    <!--view action of stock produccion lot-->
    <record id="action_tr_stock_production_lot" model="ir.actions.act_window">
      <field name="name">Números de serie</field>
      <field name="type">ir.actions.act_window</field>
      <field name="res_model">tr.stock.production.lot</field>
      <field name="view_mode">tree,form</field>
      <field name="view_id" ref="view_tr_stock_production_lot_tree" />
      <field name="search_view_id" ref="view_tr_stock_production_lot_search"/>
      <field name="context">{'search_default_group_by_product': 1, 'search_default_stock': 1, 'default_company_id': allowed_company_ids[0]}</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          Crear Nuevo Número de Serie
        </p>
      </field>
    </record>
  
    <menuitem 
      id="menu_tr_stock_production_lot"
      name="Números de Serie"
      parent="tbps_toolroom.menu_toolroom_equipment"
      action="tbps_toolroom.action_tr_stock_production_lot"
      sequence="3"
      groups="base.group_system,group_tools_system,group_tools_manager,group_tools_user"
    />
  </data>
</odoo>
